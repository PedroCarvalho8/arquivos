      ],
      "Next": "ObterMapRun",
      "ToleratedFailureCountPath": "$.tolerancia_falha_qtd"
    },
    "ObterMapRun": {
      "Comment": "itemCounts nativo do Map Run substitui o antigo passo de preparacao de metadados.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:listMapRuns",
      "Parameters": {
        "ExecutionArn.$": "$$.Execution.Id"
      },
      "ResultSelector": {
        "arn.$": "$.MapRuns[0].MapRunArn"
      },
      "ResultPath": "$.map_run",
      "Next": "DescreverMapRun"
    },
    "DescreverMapRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sfn:describeMapRun",
      "Parameters": {
        "MapRunArn.$": "$.map_run.arn"
      },
      "ResultSelector": {
        "total.$": "$.ItemCounts.Total",
        "sucesso.$": "$.ItemCounts.Succeeded",
        "falha.$": "$.ItemCounts.Failed",
        "abortado.$": "$.ItemCounts.Aborted"
      },
      "ResultPath": "$.contagens",
      "Next": "AvaliarCompletude"
    },
    "AvaliarCompletude": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.contagens.total",
          "NumericEquals": 0,
          "Next": "AlertarLoteVazio"
        },
        {
          "Variable": "$.contagens.falha",
          "NumericGreaterThan": 0,
          "Next": "AlertarFalhaParcial"
        },
        {
          "And": [
            {
              "Variable": "$.total_esperado",
              "IsPresent": true
            },
            {
              "Not": {
                "Variable": "$.contagens.total",
                "NumericEqualsPath": "$.total_esperado"
              }
            }
          ],
          "Next": "AlertarDivergencia"
        }
      ],
      "Default": "EscolherTratador"
    },
    "AlertarLoteVazio": {
      "Comment": "Zero itens raramente e normal: costuma indicar prefixo errado ou produtor que nao gerou saida.",
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:000000000000:alertas-placeholder",
        "Subject.$": "States.Format('Lote {} vazio', $.tipo_lote)",
        "Message": {
          "execution_id.$": "$$.Execution.Name",
          "prefixo.$": "$.prefixo_entrada"
        }
      },
      "ResultPath": null,
      "Next": "FinalizarLote"
    },
    "EscolherTratador": {
      "Comment": "Mesma convencao de nome da executora, aplicada ao pos-processamento. Nenhum codigo dinamico: o compute e escolhido entre opcoes fixas.",
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.compute_saida",
          "StringEquals": "athena",
          "Next": "TratadorAthena"
        },
        {
          "Variable": "$.compute_saida",
          "StringEquals": "lambda",
          "Next": "TratadorLambda"
        },
        {
          "Variable": "$.compute_saida",
          "StringEquals": "glue",
          "Next": "TratadorGlue"
        }
      ],
      "Default": "FinalizarLote"
    },
    "TratadorAthena": {
      "Comment": "SQL vive num prepared statement por dominio (aws_athena_prepared_statement). O input so fornece o parametro - nada de SQL vindo do payload.",
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
      "Parameters": {
        "QueryString.$": "States.Format('EXECUTE tratador_lote_{} USING ''{}''', $.tipo_lote, $$.Execution.Name)",
        "WorkGroup": "workgroup-placeholder"
      },
      "ResultPath": "$.tratamento",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "AlertarFalha"
        }
      ],
      "Next": "FinalizarLote",
      "TimeoutSeconds": 1800
    },
    "TratadorLambda": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "States.Format('tratador-lote-{}:live', $.tipo_lote)",
        "Payload": {
          "manifesto_saida.$": "$.resultado_map.ResultWriterDetails.Key",
          "bucket_resultados": "bucket-resultados-placeholder",
          "execution_id.$": "$$.Execution.Name",
          "contagens.$": "$.contagens"
        }
      },
      "ResultPath": "$.tratamento",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "AlertarFalha"
        }
      ],
      "Next": "FinalizarLote",
      "TimeoutSeconds": 900
    },
    "TratadorGlue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName.$": "States.Format('tratador-lote-{}', $.tipo_lote)",
        "Arguments": {
          "--manifesto_saida.$": "$.resultado_map.ResultWriterDetails.Key",
          "--bucket_resultados": "bucket-resultados-placeholder",
          "--execution_id.$": "$$.Execution.Name"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 10,
          "BackoffRate": 1.5
        }
      ],
      "ResultPath": "$.tratamento",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "AlertarFalha"
        }
      ],
      "Next": "FinalizarLote",
      "TimeoutSeconds": 7200
    },
    "AlertarFalhaParcial": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:000000000000:alertas-placeholder",
        "Subject.$": "States.Format('Lote {} com falhas parciais', $.tipo_lote)",
        "Message": {
          "execution_id.$": "$$.Execution.Name",
          "contagens.$": "$.contagens",
          "manifesto.$": "$.resultado_map.ResultWriterDetails.Key"
        }
      },
      "ResultPath": null,
      "Comment": "Alerta mas segue: a reconciliacao ainda deve rodar para os itens que passaram.",
      "Next": "EscolherTratador"
    },
    "AlertarDivergencia": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:000000000000:alertas-placeholder",
        "Subject.$": "States.Format('Lote {}: divergencia de contagem', $.tipo_lote)",
        "Message": {
          "esperado.$": "$.total_esperado",
          "lido.$": "$.contagens.total",
          "execution_id.$": "$$.Execution.Name"
        }
      },
      "ResultPath": null,
      "Next": "FinalizarLoteFalha"
    },
    "AlertarFalha": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:000000000000:alertas-placeholder",
        "Subject.$": "States.Format('Lote {} falhou', $.tipo_lote)",
        "Message.$": "$.erro"
      },
      "ResultPath": null,
      "Next": "FinalizarLoteFalha"
    },
    "FinalizarLote": {
      "Comment": "status/total sao palavras reservadas no DynamoDB - por isso os nomes itens_* e o alias #st.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "tabela-lotes-placeholder",
        "Key": {
          "pk": {
            "S.$": "States.Format('LOTE#{}', $.tipo_lote)"
          },
          "sk": {
            "S.$": "$$.Execution.Name"
          }
        },
        "UpdateExpression": "SET #st = :st, itens_total = :t, itens_sucesso = :s, itens_falha = :f, manifesto_saida = :m",
        "ExpressionAttributeNames": {
          "#st": "status_lote"
        },
        "ExpressionAttributeValues": {
          ":st": {
            "S": "CONCLUIDO"
          },
          ":t": {
            "N.$": "States.Format('{}', $.contagens.total)"
          },
          ":s": {
            "N.$": "States.Format('{}', $.contagens.sucesso)"
          },
          ":f": {
            "N.$": "States.Format('{}', $.contagens.falha)"
          },
          ":m": {
            "S.$": "$.resultado_map.ResultWriterDetails.Key"
          }
        }
      },
      "ResultPath": null,
      "Next": "Sucesso"
    },
    "FinalizarLoteFalha": {
      "Comment": "So referencia $.erro: pode ser alcancado antes de $.contagens existir.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "tabela-lotes-placeholder",
        "Key": {
          "pk": {
            "S.$": "States.Format('LOTE#{}', $.tipo_lote)"
          },
          "sk": {
            "S.$": "$$.Execution.Name"
          }
        },
        "UpdateExpression": "SET #st = :st, erro = :e",
        "ExpressionAttributeNames": {
          "#st": "status_lote"
        },
        "ExpressionAttributeValues": {
          ":st": {
            "S": "FALHOU"
          },
          ":e": {
            "S.$": "States.JsonToString($.erro)"
          }
        }
      },
      "ResultPath": null,
      "Next": "Falha"
    },
    "FalhaEntrada": {
      "Type": "Fail",
      "Error": "EntradaInvalida",
      "Cause": "tipo_lote inexistente ou contagem divergente do esperado"
    },
    "Falha": {
      "Type": "Fail",
      "Error": "LoteFalhou"
    },
    "Sucesso": {
      "Type": "Succeed"
    }
  },
  "TimeoutSeconds": 86400
}
