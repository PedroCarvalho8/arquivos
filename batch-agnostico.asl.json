{
  "Comment": "Maquina agnostica de processamento em lote. Le um prefixo S3 (LOAD_AND_FLATTEN), processa linha a linha via executora-lote-{tipo_lote}, e delega o pos-processamento a um compute escolhido por input.",
  "StartAt": "DefinirPadroes",
  "States": {
    "DefinirPadroes": {
      "Comment": "MaxConcurrencyPath e MaxItemsPerBatchPath FALHAM se o campo nao existir no input - nao ha fallback implicito. Estes dois Pass garantem o default sem obrigar o chamador a preencher tudo.",
      "Type": "Pass",
      "Parameters": {
        "padroes": {
          "itens_por_batch": 100,
          "max_concurrency": 500,
          "tolerancia_falha_pct": 5,
          "compute_saida": "nenhum",
          "contexto_lote": {},
          "tolerancia_falha_qtd": 5
        },
        "entrada.$": "$"
      },
      "Next": "MesclarPadroes"
    },
    "MesclarPadroes": {
      "Comment": "JsonMerge e raso e o segundo argumento vence: o input do chamador sobrescreve os padroes.",
      "Type": "Pass",
      "Parameters": {
        "cfg.$": "States.JsonMerge($.padroes, $.entrada, false)"
      },
      "OutputPath": "$.cfg",
      "Next": "ValidarExecutora"
    },
    "ValidarExecutora": {
      "Comment": "Falha rapido (~200ms) se tipo_lote estiver errado, em vez de descobrir dentro do Map.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:lambda:getFunction",
      "Parameters": {
        "FunctionName.$": "States.Format('executora-lote-{}:live', $.tipo_lote)"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "FalhaEntrada"
        }
      ],
      "Next": "EscolherValidacaoTratador"
    },
    "EscolherValidacaoTratador": {
      "Comment": "Valida a tratadora ANTES do Map: descobrir que ela nao existe depois de 6h de lote significa lote publicado sem reconciliacao.",
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.compute_saida",
          "StringEquals": "lambda",
          "Next": "ValidarTratadorLambda"
        },
        {
          "Variable": "$.compute_saida",
          "StringEquals": "glue",
          "Next": "ValidarTratadorGlue"
        },
        {
          "Variable": "$.compute_saida",
          "StringEquals": "athena",
          "Next": "ValidarTratadorAthena"
        },
        {
          "Variable": "$.compute_saida",
          "StringEquals": "nenhum",
          "Next": "RegistrarLote"
        }
      ],
      "Default": "FalhaEntrada"
    },
    "ValidarTratadorLambda": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:lambda:getFunction",
      "Parameters": {
        "FunctionName.$": "States.Format('tratador-lote-{}:live', $.tipo_lote)"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "FalhaEntrada"
        }
      ],
      "Next": "RegistrarLote"
    },
    "ValidarTratadorGlue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getJob",
      "Parameters": {
        "JobName.$": "States.Format('tratador-lote-{}', $.tipo_lote)"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "FalhaEntrada"
        }
      ],
      "Next": "RegistrarLote"
    },
    "ValidarTratadorAthena": {
      "Comment": "Confere o prepared statement: o Choice sozinho nao garante que o SQL do dominio foi provisionado.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:athena:getPreparedStatement",
      "Parameters": {
        "StatementName.$": "States.Format('tratador_lote_{}', $.tipo_lote)",
        "WorkGroup": "workgroup-placeholder"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "FalhaEntrada"
        }
      ],
      "Next": "RegistrarLote"
    },
    "RegistrarLote": {
      "Comment": "Substitui a lambda prepara-metadados: integracao SDK direta, zero codigo. Sem ConditionExpression, para nao quebrar redrive.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "tabela-lotes-placeholder",
        "Item": {
          "pk": {
            "S.$": "States.Format('LOTE#{}', $.tipo_lote)"
          },
          "sk": {
            "S.$": "$$.Execution.Name"
          },
          "status_lote": {
            "S": "EM_EXECUCAO"
          },
          "tipo_lote": {
            "S.$": "$.tipo_lote"
          },
          "prefixo": {
            "S.$": "$.prefixo_entrada"
          },
          "iniciado_em": {
            "S.$": "$$.Execution.StartTime"
          },
          "execution_arn": {
            "S.$": "$$.Execution.Id"
          },
          "contexto": {
            "S.$": "States.JsonToString($.contexto_lote)"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ThrottlingException",
            "DynamoDB.SdkClientException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Next": "EscolherLeitor"
    },
    "EscolherLeitor": {
      "Comment": "Um Map por leitor: ItemReader e integralmente estatico (Resource, InputType e ate as chaves de Parameters nao aceitam JSONPath).",
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.leitor",
          "StringEquals": "parquet",
          "Next": "MapParquet"
        },
        {
          "Variable": "$.leitor",
          "StringEquals": "jsonl",
          "Next": "MapJsonl"
        },
        {
          "Variable": "$.leitor",
          "StringEquals": "json",
          "Next": "MapJson"
        },
        {
          "Variable": "$.leitor",
          "StringEquals": "csv",
          "Next": "MapCsv"
        },
        {
          "Variable": "$.leitor",
          "StringEquals": "csv_ponto_virgula",
          "Next": "MapCsvPontoVirgula"
        },
        {
          "Variable": "$.leitor",
          "StringEquals": "objetos",
          "Next": "MapObjetos"
        },
        {
          "Variable": "$.leitor",
          "StringEquals": "inventario",
          "Next": "MapInventario"
        }
      ],
      "Default": "FalhaEntrada"
    },
    "MapParquet": {
      "Type": "Map",
      "Label": "Parquet",
      "MaxConcurrencyPath": "$.max_concurrency",
      "ToleratedFailurePercentagePath": "$.tolerancia_falha_pct",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:listObjectsV2",
        "ReaderConfig": {
          "InputType": "PARQUET",
          "Transformation": "LOAD_AND_FLATTEN"
        },
        "Parameters": {
          "Bucket.$": "$.bucket_entrada",
          "Prefix.$": "$.prefixo_entrada"
        }
      },
      "ItemSelector": {
        "item.$": "$$.Map.Item.Value",
        "origem.$": "$$.Map.Item.Source"
      },
      "ItemBatcher": {
        "MaxItemsPerBatchPath": "$.itens_por_batch",
        "BatchInput": {
          "tipo_lote.$": "$.tipo_lote",
          "execution_id.$": "$$.Execution.Name",
          "contexto.$": "$.contexto_lote"
        }
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "InvocarExecutora",
        "States": {
          "InvocarExecutora": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('executora-lote-{}:live', $.BatchInput.tipo_lote)",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "End": true
          }
        }
      },
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Parameters": {
          "Bucket": "bucket-resultados-placeholder",
          "Prefix.$": "States.Format('{}/{}', $.tipo_lote, $$.Execution.Name)"
        }
      },
      "ResultPath": "$.resultado_map",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "AlertarFalha"
        }
      ],
      "Next": "ObterMapRun",
      "ToleratedFailureCountPath": "$.tolerancia_falha_qtd"
    },
